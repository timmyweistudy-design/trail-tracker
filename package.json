{
  "name": "trail-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "循徑拾光 Gather the Trail — 台灣登山步道 PWA / Capacitor App",
  "scripts": {
    "check": "node scripts/check.js",
    "e2e": "node scripts/e2e.js",
    "add:android": "cap add android",
    "sync": "cap sync",
    "open:android": "cap open android",
    "assets": "capacitor-assets generate --iconBackgroundColor #16301f --splashBackgroundColor #16301f",
    "data:update": "python3 data/build_data.py && python3 data/refine_geo.py && node data/apply_geo.js && node scripts/pack-trails.mjs && node scripts/shard-geo.mjs && node scripts/check.js",
    "data:pack": "node scripts/pack-trails.mjs && node scripts/shard-geo.mjs"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.3",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/camera": "^6.1.3",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/push-notifications": "^6.0.5",
    "@revenuecat/purchases-capacitor": "^9.2.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2",
    "playwright": "^1.61.1"
  }
}
